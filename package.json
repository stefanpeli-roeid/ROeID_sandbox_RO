{
  "name": "eudi-vp-debugger",
  "version": "0.0.1",
  "description": "Public web-based debugging tool for OpenID4VP Presentation Requests and Responses, supporting EUDI Wallet Architecture & Reference Framework",
  "main": "dist/index.js",
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:web",
    "build:core": "tsc && mkdir -p dist/security/trustlist dist/security/issuer && cp src/security/trustlist/* dist/security/trustlist/ && cp src/security/issuer/*.pem dist/security/issuer/",
    "build:api": "cd api && npm run build",
    "build:web": "cd web && npm run build",
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "test": "npm run build:core && node --test dist/tests/**/*.test.js",
    "test:unit": "npm run build:core && node --test dist/tests/unit/*.test.js",
    "test:integration": "npm run build:core && node --test dist/tests/integration/*.test.js",
    "test:debug": "npm run build:core && node --test dist/tests/debug/*.test.js",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist && cd api && npm run clean && cd ../web && rm -rf dist && cd .."
  },
  "keywords": [
    "openid4vp",
    "verifiable-credentials",
    "sd-jwt",
    "iso-mdoc",
    "eudi-wallet",
    "debugging"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@animo-id/mdoc": "^0.5.2",
    "@credo-ts/core": "^0.6.2",
    "@credo-ts/node": "^0.6.2",
    "@credo-ts/openid4vc": "^0.6.2",
    "@owf/mdoc": "^0.6.0",
    "asn1js": "^3.0.10",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jose": "^6.1.3",
    "pkijs": "^3.4.0",
    "tsx": "^4.7.0",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.50.0",
    "typescript": "^5.3.0"
  }
}
